# EC2 backend runtime configuration. Copy to /opt/carebridge/.env and replace every placeholder.
NODE_ENV=production
POSTGRES_DB=carebridge
POSTGRES_USER=carebridge
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://REPLACE_WITH_S3_WEBSITE_ENDPOINT
PAYMENT_MODE=external
VITE_PAYMENT_MODE=external
