BOOTSTRAP_RECEPTION_PASSWORD=REPLACE_WITH_LOCAL_RECEPTION_PASSWORD
BOOTSTRAP_PATIENT_EMAIL=patient@local.carebridge
BOOTSTRAP_PATIENT_PASSWORD=REPLACE_WITH_LOCAL_PATIENT_PASSWORD
BOOTSTRAP_DOCTOR_PASSWORD=REPLACE_WITH_LOCAL_DOCTOR_PASSWORD
